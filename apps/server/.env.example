HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# For a physical phone on your trusted LAN, use HOST=0.0.0.0.
# Increment 02 database commands require a private PostgreSQL connection.
# Ownership requires a dedicated session; do not use a transaction pooler.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/typeduel
# Integration tests must target a disposable database, never production.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/typeduel_test
# Configure both values to enable the authenticated multiplayer adapter.
# Existing Supabase project with asymmetric JWT signing; no project is provisioned.
# SUPABASE_URL=https://PROJECT.supabase.co
# GAME_SCHEMA=typeduel_game
# Browser origins, comma-separated. Native clients need no Origin header.
# GAME_ALLOWED_ORIGINS=https://your-approved-development-origin.example
# Without both DATABASE_URL and SUPABASE_URL, only M0 liveness routes run.
# Production content remains unavailable until the separately approved audio increment.
