{
  "name": "@typeduel/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@typeduel/contracts": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.7",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "socket.io": "4.8.4",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@typeduel/config": "workspace:*",
    "@types/node": "24.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "drizzle-kit": "0.31.11",
    "@types/pg": "8.23.1",
    "socket.io-client": "4.8.4"
  }
}
