        "match_status": {
          "name": "match_status",
          "value": "\"matches\".\"status\" in ('PREPARING_ROUND','COUNTDOWN','PLAYING_WORD','ACTIVE_TYPING','ROUND_RESULT','COMPLETED','ABORTED')"
        },
        "match_terminal": {
          "name": "match_terminal",
          "value": "((\"matches\".\"status\" = 'ABORTED' and \"matches\".\"winner_id\" is null and not \"matches\".\"is_draw\" and \"matches\".\"interruption_reason\" in ('DISCONNECT_TIMEOUT','SOURCE_UNAVAILABLE','SERVER_RESTART')) or (\"matches\".\"status\" = 'COMPLETED' and \"matches\".\"interruption_reason\" is null and \"matches\".\"round_number\" between 5 and 8 and ((\"matches\".\"is_draw\" and \"matches\".\"winner_id\" is null and \"matches\".\"round_number\" = 8 and \"matches\".\"player1_score\" = \"matches\".\"player2_score\") or (not \"matches\".\"is_draw\" and ((\"matches\".\"winner_id\" = \"matches\".\"player1_id\" and \"matches\".\"player1_score\" > \"matches\".\"player2_score\") or (\"matches\".\"winner_id\" = \"matches\".\"player2_id\" and \"matches\".\"player2_score\" > \"matches\".\"player1_score\"))))) or (\"matches\".\"status\" not in ('ABORTED','COMPLETED') and \"matches\".\"winner_id\" is null and not \"matches\".\"is_draw\" and \"matches\".\"interruption_reason\" is null)) IS TRUE"
        }
