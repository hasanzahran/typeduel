# Android emulator: http://10.0.2.2:3000
# Physical phone: http://YOUR_LAN_IP:3000 (server HOST=0.0.0.0)
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Public project configuration only; no passwords, access tokens or service-role keys.
