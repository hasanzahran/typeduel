# Public URL only: never add credentials or answers to EXPO_PUBLIC_*.
# iOS simulator: http://127.0.0.1:3000
# Android emulator: http://10.0.2.2:3000
# Physical live match: reachable HTTPS origin (same as GAME_PUBLIC_ORIGIN).
# Plain HTTP emulator URLs are for M0 health checks, not authenticated audio.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Public project configuration only; no passwords, access tokens or service-role keys.
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# A Metro QR code does not expose API/audio routes; use a separately reachable HTTPS API.
